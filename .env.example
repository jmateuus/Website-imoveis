# Copie para .env. Use credenciais próprias; este arquivo não contém senhas.
POSTGRES_DB=imoveis
POSTGRES_USER=imoveis
POSTGRES_PASSWORD=
# Opcional: porta do banco no host ao usar compose.dev.yaml/API fora do Docker.
POSTGRES_PORT=5432
S3_ACCESS_KEY=
S3_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=false
# O modo demo é opcional e só insere exemplos em um banco vazio.
DEMO_DATA=false
